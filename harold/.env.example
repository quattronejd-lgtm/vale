# Harold environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.

# ---- Instagram Graph API (publish.js) ----
# The IG *user* id (Instagram Business/Creator account id) and a long-lived token
# with instagram_content_publish permission.
IG_USER_ID=1784xxxxxxxxxxxx
IG_ACCESS_TOKEN=EAAG...your-long-lived-token
# Optional: override the Graph API version base.
# IG_GRAPH_BASE=https://graph.facebook.com/v21.0

# ---- Cloudflare R2 public image hosting (publish.js) ----
# The Graph API can only ingest a PUBLIC image URL. Harold uploads the card to
# R2 under a dated key (card-YYYY-MM-DD.jpg) and hands Meta the public URL.
# Dashboard: R2 -> your bucket -> Settings (public access) + API tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=harold-cards
# Where the bucket is publicly served: the bucket's r2.dev URL or custom domain.
PUBLIC_IMAGE_BASE=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ---- Editorial LLM (editorial.js) — optional ----
# If set, pickOrangeWords() uses Anthropic; otherwise a local heuristic is used.
ANTHROPIC_API_KEY=sk-ant-your-key
# HAROLD_EDITORIAL_MODEL=claude-haiku-4-5-20251001

# ---- Fetch (fetch.js) — optional ----
# Override the feed for staging/testing.
# HAROLD_FEED_URL=https://www.goodnewsnetwork.org/feed/

# ---- Rendering (render.js) — optional ----
# Path to a Chromium binary; defaults to the Playwright-managed one.
# HAROLD_CHROMIUM=/opt/pw-browsers/chromium
